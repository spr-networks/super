# SPR on Pi 5 / CM5 (as the NixOS and raspbian images):
#   PCIe x1 (NVMe / WiFi M.2 / HATs), the 32-bit DMA quirk and Pi 5 compat
#   overlay for the mt76 cards, UART0 on GPIO14/15 for the serial console
dtparam=pciex1
dtparam=pciex4_reset=0
dtparam=uart0=on
dtparam=uart0_console
enable_uart=1
dtoverlay=uart0
dtoverlay=pcie-32bit-dma
dtoverlay=pciex1-compat-pi5,no-mip
