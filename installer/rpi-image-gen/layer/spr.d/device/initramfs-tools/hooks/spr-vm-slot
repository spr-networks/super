#!/bin/sh
# the QEMU slot mapping (98-spr-vm-slot.rules) in the initramfs too, where
# the root slot is picked

case $1 in
   prereqs) echo ""; exit 0;;
esac

. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/lib/spr/libexec/vm-slot
copy_file config /etc/udev/rules.d/98-spr-vm-slot.rules /etc/udev/rules.d/98-spr-vm-slot.rules
