#!/bin/bash
# Root's password becomes the admin password at setup, as on the other SPR
# images: the API's /setup leaves a bcrypt hash of it in
# configs/base/.setup_syshash, applied once .setup_done appears. /etc is
# read-only, so root's shadow lives in /var/lib/spr-auth (spr-shadow).
base=/var/lib/spr/configs/base
until [ -f "$base/.setup_done" ]; do
  inotifywait -q -t 60 -e create,modify,move "$base" > /dev/null || sleep 1
done
if [ -f "$base/.setup_syshash" ]; then
  hash=$(cat "$base/.setup_syshash")
  # one bcrypt hash only: it becomes a shadow field
  if [[ "$hash" =~ ^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$ ]]; then
    shadow=/var/lib/spr-auth/shadow
    [ -f "$shadow" ] || install -m 0640 -g shadow /etc/shadow "$shadow"
    new=$(awk -F: -v OFS=: -v h="$hash" '$1 == "root" { $2 = h } 1' "$shadow")
    # in place: /etc/shadow is a bind mount of this file
    printf '%s\n' "$new" > "$shadow"
    findmnt -n /etc/shadow > /dev/null || mount --bind "$shadow" /etc/shadow
  else
    echo "ignoring malformed .setup_syshash"
  fi
  rm -f "$base/.setup_syshash"
fi
