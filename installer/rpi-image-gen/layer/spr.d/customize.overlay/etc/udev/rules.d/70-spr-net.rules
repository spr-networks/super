# Pi 5 / CM5 PCIe ethernet
SUBSYSTEM=="net", ACTION=="add", ENV{DEVTYPE}!="wlan", DEVPATH=="*0001:01:00.0*", NAME="eth0"
SUBSYSTEM=="net", ACTION=="add", DEVPATH=="*0000:03:00.0*", NAME="eth1"
# Only name the base radio; AP/VLAN children share its SDIO parent.
ACTION=="add", SUBSYSTEM=="net", SUBSYSTEMS=="sdio", DRIVERS=="brcmfmac", KERNEL=="wlan[0-9]*", KERNEL!="*.*", KERNEL!="wlan0", RUN+="/usr/lib/spr/libexec/wlan0-swap %k"
ACTION=="add", SUBSYSTEM=="net", ENV{DEVTYPE}=="wlan", TAG+="systemd", ENV{SYSTEMD_WANTS}+="spr-wifi-names.service"
